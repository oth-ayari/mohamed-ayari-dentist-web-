generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Admin {
  id             String    @id @default(cuid()) @db.VarChar(191)
  name           String
  email          String    @unique @db.VarChar(191)
  hashedPassword String
  role           AdminRole @default(ADMIN)
  // Security tracking fields
  lastLoginAt    DateTime?
  lastLoginIp    String?   @db.VarChar(64)
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  refreshTokens RefreshToken[]
  recoveryCodes RecoveryCode[]
  auditLogs     AuditLog[]

  @@index([email])
  @@map("admins")
}

model Appointment {
  id              String            @id @default(cuid()) @db.VarChar(191)
  patientName     String
  email           String            @db.VarChar(191)
  phone           String
  selectedService String
  appointmentDate DateTime
  appointmentTime String
  message         String?           @db.Text
  status          AppointmentStatus @default(PENDING)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([email])
  @@index([status])
  @@index([appointmentDate])
  @@index([createdAt])
  @@map("appointments")
}

model ContactMessage {
  id        String   @id @default(cuid()) @db.VarChar(191)
  fullName  String
  email     String   @db.VarChar(191)
  phone     String?
  subject   String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([createdAt])
  @@map("contact_messages")
}

model WebsiteVisitor {
  id         String   @id @default(cuid()) @db.VarChar(191)
  ipAddress  String   @db.VarChar(191)
  country    String?
  city       String?
  deviceType String?
  browser    String?
  os         String?
  referrer   String?  @db.VarChar(500)
  page       String   @default("/") @db.VarChar(500)
  sessionId  String?  @db.VarChar(191)
  visitedAt  DateTime @default(now())

  @@index([visitedAt])
  @@index([ipAddress])
  @@index([sessionId])
  @@map("website_visitors")
}

model Analytics {
  id                   String   @id @default(cuid()) @db.VarChar(191)
  date                 DateTime @unique @db.Date
  totalVisits          Int      @default(0)
  uniqueVisitors       Int      @default(0)
  bookingCount         Int      @default(0)
  contactMessagesCount Int      @default(0)
  updatedAt            DateTime @updatedAt

  @@index([date])
  @@map("analytics")
}

model Testimonial {
  id          String   @id @default(cuid()) @db.VarChar(191)
  patientName String
  rating      Int      @default(5)
  review      String   @db.Text
  service     String?
  approved    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([approved])
  @@index([createdAt])
  @@map("testimonials")
}

model GalleryImage {
  id           String   @id @default(cuid()) @db.VarChar(191)
  imageUrl     String   @db.VarChar(1000)
  thumbnailUrl String?  @db.VarChar(1000)
  category     String   @db.VarChar(191)
  title        String?
  altText      String?
  uploadedAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category])
  @@index([uploadedAt])
  @@map("gallery_images")
}

model RefreshToken {
  id        String   @id @default(cuid()) @db.VarChar(191)
  // Reduced to 512 to stay within MySQL index size limit (512 * 4 = 2048 < 3072)
  token     String   @unique @db.VarChar(512)
  adminId   String   @db.VarChar(191)
  expiresAt DateTime
  createdAt DateTime @default(now())

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([adminId])
  @@map("refresh_tokens")
}

// One-time recovery codes for password reset when no email is available
model RecoveryCode {
  id        String    @id @default(cuid()) @db.VarChar(191)
  adminId   String    @db.VarChar(191)
  codeHash  String    @db.VarChar(191)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@map("recovery_codes")
}

// Immutable audit trail of all admin actions
model AuditLog {
  id        String   @id @default(cuid()) @db.VarChar(191)
  adminId   String   @db.VarChar(191)
  action    String   @db.VarChar(191)
  details   String?  @db.Text
  ipAddress String?  @db.VarChar(64)
  userAgent String?  @db.VarChar(500)
  createdAt DateTime @default(now())

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([createdAt])
  @@map("audit_logs")
}

// Track all login attempts for detection and lockout
model LoginAttempt {
  id        String   @id @default(cuid()) @db.VarChar(191)
  email     String   @db.VarChar(191)
  ipAddress String   @db.VarChar(64)
  success   Boolean  @default(false)
  userAgent String?  @db.VarChar(500)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([ipAddress])
  @@index([createdAt])
  @@map("login_attempts")
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}
